#!/bin/bash
# decoy-status - one screen telling you whether the collection is alive.
# The failures that matter here are silent, so this prints the things that
# would be quietly wrong: service down, events stopped, disk full, and the
# outbound block gone.
#
# Lives at /usr/local/bin/decoy-status, mode 755, root-owned.
# Needs sudo: the Cowrie log sits in another user's home, and the firewall
# check reads iptables.
set -u

LOGDIR=/home/cowrie/cowrie/var/log/cowrie
DOWNLOADS=/home/cowrie/cowrie/var/lib/cowrie/downloads
COWRIE_UID=1001

# Outbound connections were blocked on 29 September 2026 at about 12:00 UTC.
# The last file Cowrie fetched over the network was at 08:51 that morning, so
# any url-bearing download after this cutoff means the block has failed.
# See docs/rules-of-engagement.md, "The outbound download problem".
BLOCK_CUTOFF=2026-09-29T12:00
#
# A first version of this check counted FILES in the downloads directory against
# a baseline instead, and produced a false alarm within the hour. That directory
# is not "downloads": it holds every file whose content Cowrie captured,
# including files attackers push over SCP and the output of shell redirections,
# and those keep arriving whether or not outbound is blocked. Counting them
# measures attacker activity, not our firewall. The discriminator is the `url`
# field: present means Cowrie went and got it, absent means the attacker
# supplied the bytes.

echo
echo "  decoy-01 status - $(date -u '+%Y-%m-%d %H:%M:%S UTC')"
echo

if systemctl is-active --quiet cowrie.service; then
  echo "  service      running"
else
  echo "  service      NOT RUNNING"
fi

# --- the outbound block -------------------------------------------------
# A ufw or kernel package upgrade can replace before.rules and silently drop
# this rule. Silently is the problem, so it gets checked on every status read.
if iptables -L ufw-before-output -n 2>/dev/null \
     | grep -q "owner UID match ${COWRIE_UID}"; then
  echo "  outbound     blocked for cowrie (uid ${COWRIE_UID})"
else
  echo "  outbound     *** BLOCK MISSING - the decoy can reach out ***"
  echo "               re-add the rule in /etc/ufw/before.rules and ufw reload"
  echo "               see docs/build.md, 'Stopping the decoys reaching out'"
fi

# Second, independent canary: the rule could be present but ineffective.
# Reading the rule is intent; counting fetches after the cutoff is evidence.
python3 - "$LOGDIR" "$BLOCK_CUTOFF" <<'PY'
import glob, json, os, sys

logdir, cutoff = sys.argv[1], sys.argv[2]
fetched_after, hosts = 0, set()
for path in sorted(glob.glob(os.path.join(logdir, 'cowrie.json*'))):
    with open(path, errors='replace') as fh:
        for line in fh:
            if 'file_download' not in line:
                continue
            try:
                e = json.loads(line)
            except ValueError:
                continue
            if e.get('eventid') != 'cowrie.session.file_download':
                continue
            url = e.get('url')
            if url and e.get('timestamp', '') >= cutoff:
                fetched_after += 1
                hosts.add(url.split('/')[2] if '//' in url else url)

if fetched_after:
    print("  fetches      *** %d NETWORK FETCHES SINCE THE BLOCK ***" % fetched_after)
    print("               from %s" % ', '.join(sorted(hosts))[:120])
    print("               the outbound block is not holding -- see docs/build.md")
else:
    print("  fetches      none since the block went in (correct)")
PY

if [ -d "$DOWNLOADS" ]; then
  n=$(find "$DOWNLOADS" -maxdepth 1 -type f ! -name '.gitignore' | wc -l)
  echo "  captured     $n files held (fetched, pushed over scp, and redirections)"
fi

# --- the log ------------------------------------------------------------
# Cowrie rotates daily: cowrie.json is today, cowrie.json.YYYY-MM-DD the rest.
# An earlier version of this script read cowrie.json alone and reported one
# day's figures as though they were the whole collection.
files=$(ls -1 "$LOGDIR"/cowrie.json* 2>/dev/null | wc -l)
if [ "$files" -gt 0 ]; then
  echo "  log files    $files"
  python3 - "$LOGDIR" <<'PY'
import datetime, glob, json, os, sys

newest, events, sources, unreadable = None, 0, set(), 0
for path in sorted(glob.glob(os.path.join(sys.argv[1], 'cowrie.json*'))):
    with open(path, errors='replace') as fh:
        for line in fh:
            if not line.strip():
                continue
            try:
                e = json.loads(line)
            except ValueError:
                unreadable += 1
                continue
            events += 1
            ip = e.get('src_ip')
            if ip and ip != '127.0.0.1':
                sources.add(ip)
            t = e.get('timestamp')
            if t and (newest is None or t > newest):
                newest = t

if newest:
    ts = datetime.datetime.strptime(newest[:19], '%Y-%m-%dT%H:%M:%S') \
                          .replace(tzinfo=datetime.timezone.utc)
    gap = (datetime.datetime.now(datetime.timezone.utc) - ts).total_seconds()
    print("  last event   %s  (%d min ago)"
          % (newest[:19].replace('T', ' '), gap // 60))
    if gap > 86400:
        print("  WARNING      no events for over 24 hours")

print("  events       %d across all files" % events)
print("  sources      %d distinct, loopback excluded" % len(sources))
if unreadable:
    print("  WARNING      %d log lines would not parse" % unreadable)
PY
else
  echo "  log files    NONE FOUND in $LOGDIR"
fi

echo "  disk         $(df -h / | awk 'NR==2 {print $5" used of "$2}')"
echo "  uptime       $(uptime -p)"
echo
echo "  distinct sources here is a rough count straight off the log and will"
echo "  differ slightly from ingest.py, which also excludes the analyst's own"
echo "  addresses. ingest.py is the figure to quote."
echo
